{
  "name": "forja",
  "version": "0.1.0",
  "private": true,
  "description": "Forja — plataforma de assistente de IA. Fase 2: frontend da conversação com fornecedor simulado.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts --watch & tsx server/main.ts",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "tsx scripts/build.ts && node --import tsx --test tests/e2e/*.e2e.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "highlight.js": "11.12.0",
    "marked": "18.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "*",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
