{
  "name": "forja",
  "version": "0.2.0",
  "private": true,
  "description": "Forja — plataforma de assistente de IA. Fase 3: API com contas, PostgreSQL, ficheiros e histórico persistente; fornecedor de modelos simulado.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts --watch & node --env-file-if-exists=.env --import tsx server/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "db:start": "scripts/pg-local.sh start",
    "db:stop": "scripts/pg-local.sh stop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "tsx scripts/build.ts && node --import tsx --test tests/e2e/*.e2e.ts",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run test:e2e",
    "test:real-model": "node --import tsx --test tests/real-model/*.test.ts",
    "eval": "tsx scripts/eval.ts",
    "agent": "tsx scripts/agent.ts",
    "agent-eval": "tsx scripts/agent-eval.ts",
    "sandbox-probe": "tsx scripts/sandbox-probe.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "11.12.0",
    "marked": "18.0.10",
    "pg": "^8.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
