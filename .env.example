# Copiar para .env (nunca commitar o .env). Todas as variáveis são validadas no arranque (server/config.ts).
NODE_ENV=development
HOST=127.0.0.1
PORT=5173

# PostgreSQL 16. Local: `npm run db:start` imprime este URL.
# Em produção usar sslmode=verify-full.
DATABASE_URL=postgres://forja:forja-dev-only@127.0.0.1:54329/forja_dev
DB_POOL_SIZE=10

# Obrigatório em produção: origem pública usada na verificação CSRF.
# PUBLIC_ORIGIN=https://forja.exemplo
# Em produção os cookies são sempre Secure; em HTTP local fica false.
COOKIE_SECURE=false
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30
SIGNUP_PER_IP_HOUR=10
LOGIN_PER_IP_MINUTE=20

# Ficheiros dos utilizadores (fora da raiz web).
STORAGE_DIR=./data/files

# Custo do scrypt (log2 N). Produção: ≥ 17.
SCRYPT_LOG_N=17

# Só true atrás de um proxy de confiança que defina X-Forwarded-For.
TRUST_PROXY=false

MOCK_DELAY_MS=14

# Catálogo de modelos (ver docs/06-modelos.md e config/models.example.json).
# MODELS_CONFIG=config/models.json
# Simulador: por defeito ligado fora de produção e desligado em produção.
# ENABLE_SIMULATOR=true
MODEL_HEALTH_INTERVAL_MS=30000

# Chaves de integrações OPCIONAIS — só referidas no catálogo pelo nome (apiKeyEnv).
# VLLM_API_KEY=
# OPENAI_API_KEY=
